# Claude Code local settings (never commit secrets)
.claude/settings.local.json

# Generated session/project state
content/context/project_state.md
content/pipeline-state/
content/analytics/*
# スプリント較正の実測データだけはコミット対象（session-sprint-rules.md §5/§6・#45）
!content/analytics/sprint/
# rejected-edit buffer（skill-creator 本体最適化ループの reject 記録・Issue #514）
!content/analytics/skillopt/
# Layer 1 / PR 前レビューの計測 JSONL（code-review スキルが追記・週次集計の入力・Issue #627 対策 E）
!content/analytics/review/
# 月次コストレポート（content/analytics/cost_monthly/）は main では追跡しない（#242）。
# 永続化は tools/commit_cost_telemetry.py がテレメトリ専用データブランチ
# telemetry/cost-data へ 1 日 1 回 push する（Stop hook 経由・gh 非依存）。
# gitignore 対象のため feature 差分・未コミット検知には構造的に現れない。

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# OS / editor
.DS_Store
*.swp

# Secrets / env
# >>> claude-code-base: secrets (managed block) >>>
# このマーカー区間は scripts/apply-to-repo.sh が下流リポジトリの .gitignore へ冪等に追記・更新する（Issue #678）。
# 区間の中身はベース側で保守し、下流固有の除外はマーカーの外に書く。
# permissions.deny（Read）・pre-tool-use-router.sh（Bash 読取）・tools/secret_scan.py（コミット/push 検知）と同じ語彙で
# 書く（各層の一致粒度は違うため厳密な同一集合ではない。語を増減するときは 4 箇所を同時に更新する）。
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_rsa[-_.]*
id_dsa
id_dsa[-_.]*
id_ecdsa
id_ecdsa[-_.]*
id_ed25519
id_ed25519[-_.]*
!*.pub
credentials
credentials.*
*-credentials
*-credentials.*
*_credentials
*_credentials.*
!*credentials*.md
service-account.json
*service-account*.json
.netrc
.git-credentials
.publish-secrets
# <<< claude-code-base: secrets <<<
.claude/worktrees/

# エフェメラルなローカル DB ファイルを誤って commit しないための一般的な安全網
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.duckdb

# 公開スナップショット抽出時の秘匿語リスト（publish-snapshot.sh が読む）は秘匿情報そのものなので
# 上の管理ブロック（.publish-secrets）で ignore している。雛形は .publish-secrets.example。
